# Server binding: use 127.0.0.1 behind reverse proxy (recommended).
APP_BIND_IP=127.0.0.1
APP_PORT=8080

# Public-facing URL returned to clients. Use HTTPS domain in production.
# For accessing the server directly over IP: http://SERVER_IP:8080
APP_PUBLIC_BASE_URL=http://localhost:8080

# Timezone for createdAt in the generate-pdf response.
MANIFEST_ACCESS_ZONE=Asia/Jakarta

# HTTP Basic Authentication (Spring Security). Required: the service refuses to start without them.
MANIFEST_API_USERNAME=ganti-username
# BCrypt hash of the password, never the password itself (see README "Cara membuat hash BCrypt").
# Keep the single quotes: they stop Docker Compose from expanding the $ characters.
MANIFEST_API_PASSWORD_HASH='GANTI_DENGAN_HASH_BCRYPT'
# Comma-separated, least privilege: MANIFEST_GENERATE, MANIFEST_CHECK, MANIFEST_APPROVAL_RESET.
MANIFEST_API_AUTHORITIES=MANIFEST_GENERATE,MANIFEST_CHECK
# Optional: false disables the account. ASDP_BASIC_AUTH_ENABLED=false opens every endpoint (never in production).
MANIFEST_API_ENABLED=true
ASDP_BASIC_AUTH_ENABLED=true
ASDP_BASIC_AUTH_REALM=asdp-internal-api

# Database for the dock_ship manifest check. Required: the service refuses to start without them.
MANIFEST_DB_URL=jdbc:mysql://DB_HOST:3306/DB_NAME
MANIFEST_DB_USERNAME=ganti-username
MANIFEST_DB_PASSWORD=ganti-password

JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=70.0 -Duser.timezone=Asia/Jakarta -Dfile.encoding=UTF-8
